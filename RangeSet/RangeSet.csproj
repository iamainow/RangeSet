<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <PackageId>RangeSet</PackageId>
    <Authors>iamainow</Authors>
    <Description>A high-performance generic range set library for .NET with zero-allocation union, intersection, and difference operations. All SpanRangeSet&lt;T&gt; operations accept caller-provided Span&lt;T&gt; result buffers, enabling fully stackalloc-based usage. AOT compatible.</Description>
    <PackageTags>range;set;operations;union;intersect;except;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iamainow/RangeSet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iamainow/RangeSet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Symbol packages for debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Source Link: enables stepping into source from consumers -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
